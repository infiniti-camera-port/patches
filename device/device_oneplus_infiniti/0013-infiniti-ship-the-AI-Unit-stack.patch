+my_stock/app/AIMemory/lib/arm64/libtensorflowlite.so:product/app/AIMemory/lib/arm64/libtensorflowlite.so;MAKE_COPY_RULE_ONLY
+my_stock/app/AIMemory/lib/arm64/libwb_tables_549543368749780587_1.so:product/app/AIMemory/lib/arm64/libwb_tables_549543368749780587_1.so;MAKE_COPY_RULE_ONLY
+my_stock/app/AIMemory/lib/arm64/libwbkit-seckit3.so:product/app/AIMemory/lib/arm64/libwbkit-seckit3.so;MAKE_COPY_RULE_ONLY
+my_product/app/AONService/AONService.apk:product/app/AONService/AONService.apk;PRESIGNED
