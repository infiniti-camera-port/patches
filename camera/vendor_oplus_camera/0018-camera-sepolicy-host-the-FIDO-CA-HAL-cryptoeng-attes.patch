 type vendor_hal_cryptoeng_oplus_service, hal_service_type, protected_service, service_manager_type;
+type vendor_hal_fido_oplus_service,  hal_service_type, protected_service, service_manager_type;
+type vendor_hal_fido2_oplus_service, hal_service_type, protected_service, service_manager_type;
