From c66945bed8e6914c9684929a1ec8a9a4011d4fe6 Mon Sep 17 00:00:00 2001
From: 1vivy <1vivy@tutanota.com>
Date: Wed, 8 Jul 2026 09:41:04 -0600
Subject: [PATCH 5/6] sm8850-common: include Oplus camera board config

The v3 camera source repo owns common camera board flags, including the AI Unit app-dir JNI PRODUCT_COPY_FILES allowance, but BoardConfig variables are not imported through product make inheritance.

Import the camera common BoardConfig from the shared device BoardConfig so every v3 variant sees the common camera build flags when the camera stack is present.
---
 BoardConfigCommon.mk | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/BoardConfigCommon.mk b/BoardConfigCommon.mk
index 4aa4816..3611bdd 100644
--- a/BoardConfigCommon.mk
+++ b/BoardConfigCommon.mk
@@ -269,3 +269,6 @@ WPA_SUPPLICANT_VERSION := VER_0_8_X
 
 # Include the proprietary files BoardConfig.
 include vendor/oneplus/sm8850-common/BoardConfigVendor.mk
+
+# Include the Oplus camera port board flags when the camera stack is present.
+-include vendor/oneplus/camera-sm8850-common/BoardConfig.mk
