+            pid_t pid,
+            uid_t uid,
+            const sp<NuPlayer::Renderer> &renderer);
+
+    virtual sp<NuPlayer::Renderer> createRenderer(
+            const sp<MediaPlayerBase::AudioSink> &sink,
+            const sp<MediaClock> &mediaClock,
+            const sp<AMessage> &notify,
+            uint32_t flags);
