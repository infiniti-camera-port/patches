+    public static boolean isCompressFileType(int fileType) {
+        return (fileType >= 0x2711 && fileType <= 0x2712) || fileType == 0x6b;
+    }
+
+    public static boolean isDocFileType(int fileType) {
+        if (fileType >= 0x2725 && fileType <= 0x272b) {
