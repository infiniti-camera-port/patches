From f00a88a4fdc0e4418609d459c67cfa3572cb4f23 Mon Sep 17 00:00:00 2001
From: 1vivy <1vivy@tutanota.com>
Date: Fri, 3 Jul 2026 15:33:06 +0000
Subject: [PATCH 16/16] infiniti: route the camera port through
 device/oneplus/infiniti-camera

Replace the direct vendor/oplus/camera/opluscamera.mk inherit with the
split-topology chain defined by the camera topology design (task-8 doc
sections 4-5): device.mk now inherits
device/oneplus/infiniti-camera/infiniti-camera.mk, which inherits
device/oneplus/sm8850-common-camera/sm8850-common-camera.mk and the
vendor/oplus/camera payload. BoardConfig.mk picks up the common camera
board fragment (BoardConfigCommonCamera.mk) for the camera sepolicy dir.

oplus-fwk.mk is already inherited via
device/oneplus/sm8850-common/common.mk (stub-inventory row K13); no
device-side inherit is added, avoiding a double inherit.

Change-Id: I8f614c1aacff7fb68460d06702cb72d8b108e988
---
 BoardConfig.mk | 3 +++
 device.mk      | 5 +++--
 2 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/BoardConfig.mk b/BoardConfig.mk
index 046642a..36a6694 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -12,6 +12,9 @@ BOARD_SUPER_PARTITION_SIZE := 17062428672
 # Include the common OEM chipset BoardConfig.
 include device/oneplus/sm8850-common/BoardConfigCommon.mk
 
+# Camera (Oplus camera port) — common camera board fragment (split topology)
+-include device/oneplus/sm8850-common-camera/BoardConfigCommonCamera.mk
+
 DEVICE_PATH := device/oneplus/infiniti
 
 # Assert
diff --git a/device.mk b/device.mk
index b36ac08..cc4038e 100644
--- a/device.mk
+++ b/device.mk
@@ -99,8 +99,9 @@ $(call inherit-product, device/oneplus/sm8850-common/common.mk)
 # Inherit from the proprietary files makefile.
 $(call inherit-product, vendor/oneplus/infiniti/infiniti-vendor.mk)
 
-# Camera (Oplus camera port)
-$(call inherit-product-if-exists, vendor/oplus/camera/opluscamera.mk)
+# Camera (Oplus camera port) — split device-camera topology:
+# infiniti-camera.mk -> sm8850-common-camera.mk -> vendor/oplus/camera payload.
+$(call inherit-product, device/oneplus/infiniti-camera/infiniti-camera.mk)
 
 # Device is 4K-pages (kernel CONFIG_ARM64_4K_PAGES=y); declare it so check_elf_file
 # does not require the 16K-readiness alignment that older 4K OEM camera JNI libs lack.
-- 
