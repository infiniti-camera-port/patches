+        }
+        if (type == LEVEL_TYPE_FOR_CPU) {
+            return sCpuLevel;
+        }
+        if (type == LEVEL_TYPE_FOR_GPU) {
+            return sGpuLevel;
+        }
+        return LEVEL_UNDEF;
     }
 
+    /** OEM source line 322-331. Stock OOS16.0.8 on infiniti returns LEVEL_HIGH (3). */
