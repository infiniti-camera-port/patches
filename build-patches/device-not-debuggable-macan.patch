From 19e4deaee873b509eabb5c416113095e560f47cc Mon Sep 17 00:00:00 2001
From: 1vivy <1vivy@tutanota.com>
Date: Sat, 25 Jul 2026 06:18:23 +0000
Subject: [PATCH] macan: clear PRODUCT_NOT_DEBUGGABLE_IN_USERDEBUG

crDroid/Lineage set PRODUCT_NOT_DEBUGGABLE_IN_USERDEBUG to true in the common
product config. Clear it after that inherit so add_json_bool emits false and
the userdebug build keeps ro.debuggable=1.

Change-Id: I13820bea57c58e694b70e480ffbe4c7cfec3078d
---
 lineage_macan.mk | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/lineage_macan.mk b/lineage_macan.mk
index 358d63e..f2d6845 100644
--- a/lineage_macan.mk
+++ b/lineage_macan.mk
@@ -14,6 +14,14 @@ $(call inherit-product, device/oneplus/macan/device.mk)
 # Inherit some common Lineage stuff.
 $(call inherit-product, vendor/lineage/config/common_full_phone.mk)
 
+# Keep the userdebug build debuggable so adb root works out of the box.
+# crDroid/Lineage set PRODUCT_NOT_DEBUGGABLE_IN_USERDEBUG := true in common.mk,
+# forcing ro.debuggable=0 and hiding the rooted-debugging developer toggle.
+# add_json_bool treats any non-empty string as true, so ":= false" is still
+# truthy. Clear the var after the common inherit so the userdebug build stays
+# debuggable.
+PRODUCT_NOT_DEBUGGABLE_IN_USERDEBUG :=
+
 PRODUCT_NAME := lineage_macan
 PRODUCT_DEVICE := macan
 PRODUCT_MANUFACTURER := OnePlus
-- 
2.25.1

