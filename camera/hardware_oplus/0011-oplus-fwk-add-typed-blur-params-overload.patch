From 181ed0a01681b4f29012d35ab36940ae750058b5 Mon Sep 17 00:00:00 2001
From: 1vivy <1vivy@tutanota.com>
Date: Tue, 16 Jun 2026 13:00:51 -0600
Subject: [PATCH 11/24] oplus-fwk: add typed blur params overload
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

(cherry picked from commit 85d56fbc3d0d6a4af78c3d9ebd4d56674779839f)

Ledger: hardware_oplus.md Accepted Group B row 4 (85d56fbc)
Stub-matrix: task-9-stub-inventory.md row K04 — consumer: OEM apps link ViewRootManager.setBlurParams(OplusBlurParam) typed signature (NoSuchMethodError otherwise); location: base ViewRootManager has only setBlurParams(Object)
Change-Id: I484b63bfe7aae6579a38f5d5d6a3ef76f31b8e9b
---
 oplus-fwk/src/com/oplus/view/ViewRootManager.java | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/oplus-fwk/src/com/oplus/view/ViewRootManager.java b/oplus-fwk/src/com/oplus/view/ViewRootManager.java
index 6fee0e6d..70a3860d 100644
--- a/oplus-fwk/src/com/oplus/view/ViewRootManager.java
+++ b/oplus-fwk/src/com/oplus/view/ViewRootManager.java
@@ -5,6 +5,7 @@ import android.util.Log;
 import android.view.View;
 import android.view.ViewRootImpl;
 import com.android.internal.graphics.drawable.BackgroundBlurDrawable;
+import com.oplus.graphics.OplusBlurParam;
 
 /* Stub implementation - OplusBlurParam not available in AOSP/LineageOS */
 public class ViewRootManager {
@@ -63,4 +64,8 @@ public class ViewRootManager {
     public void setBlurParams(Object params) {
         // no-op
     }
+
+    public void setBlurParams(OplusBlurParam params) {
+        setBlurParams((Object) params);
+    }
 }
