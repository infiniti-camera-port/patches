From 81f00bb52f3d92ae951f1c76fe1f9bde991bf65f Mon Sep 17 00:00:00 2001
From: 1vivy <1vivy@tutanota.com>
Date: Fri, 3 Jul 2026 15:37:29 +0000
Subject: [PATCH 3/3] sm8850-common: Ship system_ext libprotobuf-cpp-lite-21.12
 shim

crDroid 16.0 / bp4a defines no module named libprotobuf-cpp-lite-21.12:
prebuilts/misc protobuf_vendorcompat (pin 79b3682 "Use older
libprotobuf-cpp-{lite,full}-21.12") only provides the vendor-image
"libprotobuf-cpp-lite-21.12-vendorcompat" -- the other 37 protobuf refs
in this repo resolve to it -- while the system_ext prebuilt horae links
libprotobuf-cpp-lite-21.12.so directly (readelf DT_NEEDED), and a
system_ext module cannot use a vendor-variant library. Soong therefore
hard-fails at analysis with "depends on undefined module"
(crdroid-sm8850-camera-split wave-3-gate.md Task-12 blocker 3;
pre-existing at the pristine crDroid pins, proven with hardware/oplus
at base pin bd0e44d0).

LineageOS 23.2 resolves this in prebuilts/misc by exposing a
system_ext_specific libprotobuf-cpp-lite-21.12 ("Expose system_ext
libprotobuf-cpp-lite-21.12", e0793734). prebuilts/misc is outside this
port's repo set, so ship the same BSD-licensed prebuilt payload
(byte-identical, sha256 6a66ab44b6b3f372b05ab3c59e423f2d6eba3265f76c52
c14ecb148c2e282077) vendor-side as a subdir module of this repo's soong
namespace instead. No framework or external/ edits.

Change-Id: Ic20e5df761af6925d7ef6035b59f2d530f843cbd
---
 protobuf_shim/Android.bp                      |  51 ++++++++++++++++++
 protobuf_shim/LICENSE                         |  32 +++++++++++
 .../arm/libprotobuf-cpp-lite-21.12.so         | Bin 0 -> 406636 bytes
 .../arm64/libprotobuf-cpp-lite-21.12.so       | Bin 0 -> 548976 bytes
 4 files changed, 83 insertions(+)
 create mode 100644 protobuf_shim/Android.bp
 create mode 100644 protobuf_shim/LICENSE
 create mode 100644 protobuf_shim/arm/libprotobuf-cpp-lite-21.12.so
 create mode 100644 protobuf_shim/arm64/libprotobuf-cpp-lite-21.12.so

diff --git a/protobuf_shim/Android.bp b/protobuf_shim/Android.bp
new file mode 100644
index 0000000..ba9fddd
--- /dev/null
+++ b/protobuf_shim/Android.bp
@@ -0,0 +1,51 @@
+// system_ext libprotobuf-cpp-lite-21.12 shim.
+//
+// The system_ext prebuilt binary "horae" (proprietary/system_ext/bin/horae)
+// has DT_NEEDED libprotobuf-cpp-lite-21.12.so, but crDroid 16.0 / bp4a
+// defines no module of that name: prebuilts/misc protobuf_vendorcompat only
+// provides the vendor-image "libprotobuf-cpp-lite-21.12-vendorcompat"
+// (which the other 37 protobuf refs in this repo resolve to) and a
+// system_ext module cannot link a vendor-variant library.
+//
+// LineageOS 23.2 fixes this in prebuilts/misc by exposing a
+// system_ext_specific "libprotobuf-cpp-lite-21.12" ("Expose system_ext
+// libprotobuf-cpp-lite-21.12", e0793734). prebuilts/misc is outside this
+// port's repo set, so the same BSD-licensed prebuilt payload
+// (byte-identical to prebuilts/misc/protobuf_vendorcompat/arm64/
+// libprotobuf-cpp-lite-21.12.so, sha256 6a66ab44b6b3f372b05ab3c59e423f2d
+// 6eba3265f76c52c14ecb148c2e282077) is shipped vendor-side here instead.
+// No framework or external/ edits.
+
+package {
+    default_applicable_licenses: [
+        "vendor_oneplus_sm8850-common_protobuf_shim_license",
+    ],
+}
+
+license {
+    name: "vendor_oneplus_sm8850-common_protobuf_shim_license",
+    license_kinds: ["SPDX-license-identifier-BSD"],
+    license_text: ["LICENSE"],
+}
+
+cc_prebuilt_library_shared {
+    name: "libprotobuf-cpp-lite-21.12",
+    system_ext_specific: true,
+    target: {
+        android_arm: {
+            srcs: ["arm/libprotobuf-cpp-lite-21.12.so"],
+        },
+        android_arm64: {
+            srcs: ["arm64/libprotobuf-cpp-lite-21.12.so"],
+        },
+    },
+
+    shared_libs: [
+        "libc++",
+        "libc",
+        "libdl",
+        "liblog",
+        "libm",
+        "libz",
+    ],
+}
