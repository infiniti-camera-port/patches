From 7f9465468ab95811aedeba7ef73859318c187cb0 Mon Sep 17 00:00:00 2001
From: 1vivy <1vivy@tutanota.com>
Date: Wed, 8 Jul 2026 15:01:36 -0600
Subject: [PATCH 2/3] infiniti: wire in the Oplus camera

Sources: 947f88d006feededbccbd72b237dfb5450d7a086, f00a88a4fdc0e4418609d459c67cfa3572cb4f23, cf9b1df1023499d1296278077a6872877669e8e0

Resolved to the v3 graph: device.mk inherits vendor/oneplus/camera-infiniti/camera-infiniti.mk and BoardConfig allows the OEM camera vendor-property namespace; extract-files.py drops the waffle-era CameraHW face-detect-disable rewrite so Oplus camera keeps the donor TRUE/TRUE face-detection flags; proprietary-file rows otherwise stay in the v3 graph.

Change-Id: I7aa5d70aa02ad0c287c41f34236c0599db954137
---
 device.mk             |  3 ++
 extract-files.py      |  4 ---
 proprietary-files.txt | 65 -------------------------------------------
 3 files changed, 3 insertions(+), 69 deletions(-)

diff --git a/device.mk b/device.mk
index b8b8ae8..559fbd9 100644
--- a/device.mk
+++ b/device.mk
@@ -86,3 +86,6 @@ $(call inherit-product, device/oneplus/sm8850-common/common.mk)
 
 # Inherit from the proprietary files makefile.
 $(call inherit-product, vendor/oneplus/infiniti/infiniti-vendor.mk)
+
+# Camera (Oplus camera port)
+$(call inherit-product, vendor/oneplus/camera-infiniti/camera-infiniti.mk)
diff --git a/extract-files.py b/extract-files.py
index 441d9b6..edca928 100755
--- a/extract-files.py
+++ b/extract-files.py
@@ -37,10 +37,6 @@ lib_fixups: lib_fixups_user_type = {
 }
 
 blob_fixups: blob_fixups_user_type = {
-    'odm/etc/camera/CameraHWConfiguration.config': blob_fixup()
-        # Disable face detection AE behaviour
-        .regex_replace(r'(enableSWfdForThirdCamUnit += )TRUE', r'\1FALSE')
-        .regex_replace(r'(fdSupport += )TRUE;', r'\1FALSE;'),
     'odm/etc/init/init.camera_process.rc': blob_fixup()
         .regex_replace('    delete_recursion', '    #delete_recursion'),
     (
